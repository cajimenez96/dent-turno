# Copiá este archivo a .env.local. Nunca subas .env.local a git.

# Conexión de la aplicación (en Neon: la conexión agrupada, "pooled").
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sto
# Conexión directa para migraciones y respaldos (en Neon: sin "-pooler").
DATABASE_URL_DIRECT=postgres://postgres:postgres@localhost:5432/sto

# Solo pruebas de base de datos: se crea y borra una base temporal en este servidor.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Solo respaldos (.env.respaldo, en tu PC): rol de solo lectura y clave pública de age.
# DATABASE_URL_RESPALDO=postgres://sto_respaldo:...@host/sto
# AGE_RECIPIENT=age1...
# RESPALDO_DIR=./respaldos
